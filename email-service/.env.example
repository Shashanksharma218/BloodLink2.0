# Email microservice
PORT=5001

# Shared secret — must match EMAIL_SERVICE_SECRET in backend/.env
EMAIL_SERVICE_SECRET=change_me_to_a_long_random_value

# Gmail SMTP credentials (use an App Password, NOT your regular password)
# How to create: https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=

# From header on outgoing mail
MAIL_FROM=BloodLink <your-gmail@gmail.com>

# Used to build verification / reset / certificate links inside emails and PDFs
APP_PUBLIC_URL=http://localhost:5173
