# Server
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000

# MongoDB — must be a replica set for transactions (Atlas free tier works)
MONGO_URI=mongodb://localhost:27017/BloodLink

# JWT
JWT_SECRET=f8d4f7693e4ca6c7e1d086c4c0134e9477110ecc622fd676e7a2e562123d33fd
